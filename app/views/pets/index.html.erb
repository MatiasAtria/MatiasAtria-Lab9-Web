<h1 class="mb-4">Pets</h1>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner</th>
      <th>Date of Birth</th>
    </tr>
  </thead>

  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td><%= link_to pet.name, pet_path(pet) %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>

        <td>
          <% if pet.owner %>
            <%= link_to "#{pet.owner.first_name} #{pet.owner.last_name}", owner_path(pet.owner) %>
          <% else %>
            No owner
          <% end %>
        </td>

        <td>
          <%= pet.date_of_birth.strftime("%B %d, %Y") if pet.date_of_birth %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>