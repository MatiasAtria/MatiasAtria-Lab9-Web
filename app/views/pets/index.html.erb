<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Pets</h1>
  <% if policy(Pet).create? %>
    <%= link_to "New Pet", new_pet_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Photo</th>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner</th>
      <th>Date of Birth</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td>
          <% if pet.photo.attached? %>
            <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]), class: "rounded" %>
          <% else %>
            <div class="bg-secondary rounded" style="width:60px;height:60px;"></div>
          <% end %>
        </td>
        <td><%= link_to pet.name, pet_path(pet) %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>
        <td>
          <% if pet.owner %>
            <%= link_to "#{pet.owner.first_name} #{pet.owner.last_name}", owner_path(pet.owner) %>
          <% else %>No owner<% end %>
        </td>
        <td><%= pet.date_of_birth.strftime("%B %d, %Y") if pet.date_of_birth %></td>
        <td>
          <% if policy(pet).edit? %>
            <%= link_to "Edit", edit_pet_path(pet), class: "btn btn-sm btn-warning me-1" %>
          <% end %>
          <% if policy(pet).destroy? %>
            <%= button_to "Delete", pet_path(pet), method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-sm btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>