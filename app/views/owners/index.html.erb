<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Owners</h1>
  <% if policy(Owner).create? %>
    <%= link_to "New Owner", new_owner_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Name</th><th>Email</th><th>Phone</th><th>Pets</th><th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @owners.each do |owner| %>
      <tr>
        <td><%= link_to "#{owner.first_name} #{owner.last_name}", owner_path(owner) %></td>
        <td><%= owner.email %></td>
        <td><%= owner.phone %></td>
        <td><%= owner.pets.count %></td>
        <td>
          <% if policy(owner).edit? %>
            <%= link_to "Edit", edit_owner_path(owner), class: "btn btn-sm btn-warning me-1" %>
          <% end %>
          <% if policy(owner).destroy? %>
            <%= button_to "Delete", owner_path(owner), method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-sm btn-danger" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>