<h1>Appointment — <%= @appointment.date.strftime("%B %d, %Y") %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Pet:</strong> <%= link_to @appointment.pet.name, pet_path(@appointment.pet) %></p>
    <p><strong>Vet:</strong> <%= link_to "#{@appointment.vet.first_name} #{@appointment.vet.last_name}", vet_path(@appointment.vet) %></p>
    <p><strong>Reason:</strong> <%= @appointment.reason %></p>
    <p><strong>Status:</strong> <%= @appointment.status.humanize %></p>
  </div>
</div>

<div class="d-flex gap-2 mb-4">
  <% if policy(@appointment).edit? %>
    <%= link_to "Edit", edit_appointment_path(@appointment), class: "btn btn-warning" %>
  <% end %>
  <% if policy(@appointment).destroy? %>
    <%= button_to "Delete", appointment_path(@appointment), method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-danger" %>
  <% end %>
  <%= link_to "← Back to Appointments", appointments_path, class: "btn btn-secondary" %>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>Treatments</h3>
  <% treatment_check = Treatment.new(appointment: @appointment) %>
  <% if policy(treatment_check).create? %>
    <%= link_to "New Treatment", new_appointment_treatment_path(@appointment), class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<% if @appointment.treatments.any? %>
  <table class="table table-bordered">
    <thead class="table-light">
      <tr>
        <th>Name</th><th>Medication</th><th>Dosage</th><th>Administered At</th><th>Clinical Notes</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @appointment.treatments.each do |t| %>
        <tr>
          <td><%= t.name %></td>
          <td><%= t.medication %></td>
          <td><%= t.dosage %></td>
          <td><%= t.administered_at&.strftime("%B %d, %Y %H:%M") %></td>
          <td><%= t.clinical_notes %></td>
          <td>
            <% if policy(t).edit? %>
              <%= link_to "Edit", edit_appointment_treatment_path(@appointment, t), class: "btn btn-sm btn-warning me-1" %>
            <% end %>
            <% if policy(t).destroy? %>
              <%= button_to "Delete", appointment_treatment_path(@appointment, t), method: :delete,
                    data: { turbo_confirm: "Are you sure?" },
                    class: "btn btn-sm btn-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No treatments recorded for this appointment.</p>
<% end %>