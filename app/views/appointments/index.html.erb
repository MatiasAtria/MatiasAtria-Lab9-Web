<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Appointments</h1>
  <%= link_to "New Appointment", new_appointment_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Date</th><th>Pet</th><th>Vet</th><th>Reason</th><th>Status</th><th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @appointments.each do |appt| %>
      <tr>
        <td><%= link_to appt.date.strftime("%B %d, %Y"), appointment_path(appt) %></td>
        <td><%= appt.pet&.name || "No pet" %></td>
        <td>
          <% if appt.vet %>
            <%= "#{appt.vet.first_name} #{appt.vet.last_name}" %>
          <% else %>No vet<% end %>
        </td>
        <td><%= appt.reason %></td>
        <td><%= appt.status.humanize %></td>
        <td>
          <%= link_to "Edit", edit_appointment_path(appt), class: "btn btn-sm btn-warning me-1" %>
          <%= button_to "Delete", appointment_path(appt), method: :delete,
                data: { turbo_confirm: "Are you sure?" },
                class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>